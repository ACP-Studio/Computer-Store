// ============================================================ small helpers

string trim(const string& s) {
    size_t a = s.find_first_not_of(" \t\r\n");
    if (a == string::npos) return "";
    size_t b = s.find_last_not_of(" \t\r\n");
    return s.substr(a, b - a + 1);
}

string toLower(string s) {
    for (char& c : s) c = static_cast<char>(tolower(static_cast<unsigned char>(c)));
    return s;
}

// Money is stored as whole cents (long long) so there are no floating-point errors.
constexpr long long usd(long long dollars) { return dollars * 100; }

string formatMoney(long long cents) {
    bool negative = cents < 0;
    if (negative) cents = -cents;
    string dollars = to_string(cents / 100);
    for (int i = static_cast<int>(dollars.size()) - 3; i > 0; i -= 3)
        dollars.insert(static_cast<size_t>(i), ",");
    ostringstream os;
    os << (negative ? "-" : "") << '$' << dollars << '.' << setw(2) << setfill('0') << cents % 100;
    return os.str();
}

string num(double v, int decimals = 1) {
    ostringstream os;
    os << fixed << setprecision(decimals) << v;
    return os.str();
}

// Pads or cuts text to an exact width so table columns line up.
string fit(const string& s, size_t width) {
    if (s.size() <= width) return s + string(width - s.size(), ' ');
    return s.substr(0, width - 3) + "...";
}

string padLeft(const string& s, size_t width) {
    return s.size() >= width ? s : string(width - s.size(), ' ') + s;
}

string line(char c, size_t n) { return string(n, c); }

string timestamp(const char* format) {
    time_t t = time(nullptr);
    tm parts{};
#ifdef _WIN32
    localtime_s(&parts, &t);
#else
    localtime_r(&t, &parts);
#endif
    char buf[64];
    strftime(buf, sizeof buf, format, &parts);
    return buf;
}


// ============================================================ enums

enum class Category { Cpu, Gpu, Motherboard, Memory, Storage, PowerSupply, Case, Cooler, Monitor, Peripheral };

const vector<Category> kAllCategories = {Category::Cpu,         Category::Gpu,     Category::Motherboard,
                                              Category::Memory,      Category::Storage, Category::PowerSupply,
                                              Category::Case,        Category::Cooler,  Category::Monitor,
                                              Category::Peripheral};

const char* categoryName(Category c) {
    switch (c) {
        case Category::Cpu: return "Processors (CPU)";
        case Category::Gpu: return "Graphics Cards (GPU)";
        case Category::Motherboard: return "Motherboards";
        case Category::Memory: return "Memory (RAM)";
        case Category::Storage: return "Storage (SSD / HDD)";
        case Category::PowerSupply: return "Power Supplies (PSU)";
        case Category::Case: return "PC Cases";
        case Category::Cooler: return "CPU Coolers";
        case Category::Monitor: return "Monitors";
        case Category::Peripheral: return "Peripherals";
    }
    return "?";
}

// Ordered from smallest to largest: a case that fits ATX also fits the smaller sizes.
enum class FormFactor { MiniITX = 0, MicroATX = 1, ATX = 2 };

const char* formFactorName(FormFactor f) {
    switch (f) {
        case FormFactor::MiniITX: return "Mini-ITX";
        case FormFactor::MicroATX: return "Micro-ATX";
        case FormFactor::ATX: return "ATX";
    }
    return "?";
}

enum class StorageKind { NVMe, SataSsd, Hdd };

const char* storageKindName(StorageKind k) {
    switch (k) {
        case StorageKind::NVMe: return "NVMe SSD";
        case StorageKind::SataSsd: return "SATA SSD";
        case StorageKind::Hdd: return "Hard disk (HDD)";
    }
    return "?";
}

// ============================================================ Product hierarchy

class Product {
public:
    Product(int id, Category category, string brand, string name, long long priceCents, int stock)
        : id_(id), category_(category), brand_(move(brand)), name_(move(name)),
          priceCents_(priceCents), stock_(stock) {}
    virtual ~Product() = default;

    int id() const { return id_; }
    Category category() const { return category_; }
    const string& brand() const { return brand_; }
    const string& name() const { return name_; }
    string fullName() const { return brand_ + " " + name_; }
    long long priceCents() const { return priceCents_; }
    int stock() const { return stock_; }

    // Removes units from stock when an order is placed. Returns false if there isn't enough.
    bool takeStock(int quantity) {
        if (quantity <= 0 || quantity > stock_) return false;
        stock_ -= quantity;
        return true;
    }

    // Each kind of part describes its own technical details.
    virtual vector<string> specs() const = 0;

private:
    int id_;
    Category category_;
    string brand_, name_;
    long long priceCents_;
    int stock_;
};

class Cpu : public Product {
public:
    Cpu(int id, string brand, string name, long long price, int stock, string socket, int cores,
        int threads, double baseGhz, double boostGhz, int tdpW)
        : Product(id, Category::Cpu, move(brand), move(name), price, stock), socket_(move(socket)),
          cores_(cores), threads_(threads), baseGhz_(baseGhz), boostGhz_(boostGhz), tdpW_(tdpW) {}

    const string& socket() const { return socket_; }
    int tdpW() const { return tdpW_; }

    vector<string> specs() const override {
        return {"Socket: " + socket_,
                "Cores / threads: " + to_string(cores_) + " / " + to_string(threads_),
                "Clock: " + num(baseGhz_) + " GHz base, up to " + num(boostGhz_) + " GHz boost",
                "Power (TDP): " + to_string(tdpW_) + " W"};
    }

private:
    string socket_;
    int cores_, threads_;
    double baseGhz_, boostGhz_;
    int tdpW_;
};

class Gpu : public Product {
public:
    Gpu(int id, string brand, string name, long long price, int stock, int vramGb, int tdpW)
        : Product(id, Category::Gpu, move(brand), move(name), price, stock), vramGb_(vramGb), tdpW_(tdpW) {}

    int tdpW() const { return tdpW_; }

    vector<string> specs() const override {
        return {"Video memory: " + to_string(vramGb_) + " GB",
                "Board power: " + to_string(tdpW_) + " W"};
    }

private:
    int vramGb_, tdpW_;
};

class Motherboard : public Product {
public:
    Motherboard(int id, string brand, string name, long long price, int stock, string socket,
                string chipset, string memoryType, FormFactor form, bool wifi)
        : Product(id, Category::Motherboard, move(brand), move(name), price, stock),
          socket_(move(socket)), chipset_(move(chipset)), memoryType_(move(memoryType)),
          form_(form), wifi_(wifi) {}

    const string& socket() const { return socket_; }
    const string& memoryType() const { return memoryType_; }
    FormFactor formFactor() const { return form_; }

    vector<string> specs() const override {
        return {"CPU socket: " + socket_, "Chipset: " + chipset_, "Memory type: " + memoryType_,
                string("Size: ") + formFactorName(form_), string("Wi-Fi: ") + (wifi_ ? "yes" : "no")};
    }

private:
    string socket_, chipset_, memoryType_;
    FormFactor form_;
    bool wifi_;
};

