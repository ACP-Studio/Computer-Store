// ============================================================ Basket

struct BasketItem {
    Product* product;
    int quantity;
    long long lineTotalCents() const { return product->priceCents() * quantity; }
};

class Basket {
public:
    const vector<BasketItem>& items() const { return items_; }
    bool empty() const { return items_.empty(); }

    int unitCount() const {
        int n = 0;
        for (const auto& it : items_) n += it.quantity;
        return n;
    }

    long long totalCents() const {
        long long t = 0;
        for (const auto& it : items_) t += it.lineTotalCents();
        return t;
    }

    int quantityOf(const Product& p) const {
        for (const auto& it : items_)
            if (it.product == &p) return it.quantity;
        return 0;
    }

    // All of these report a human-readable result in `msg`.
    bool add(Product& p, int qty, string& msg) {
        if (qty <= 0) {
            msg = "Quantity must be at least 1.";
            return false;
        }
        int have = quantityOf(p);
        if (have + qty > p.stock()) {
            msg = "Not enough stock: only " + to_string(p.stock()) + " available (you already have " +
                  to_string(have) + " in your basket).";
            return false;
        }
        bool merged = false;
        for (auto& it : items_)
            if (it.product == &p) {
                it.quantity += qty;
                merged = true;
            }
        if (!merged) items_.push_back({&p, qty});
        msg = "Added " + to_string(qty) + " x " + p.fullName() + " to your basket.";
        return true;
    }

    bool removeAt(size_t index, string& msg) {
        if (index >= items_.size()) {
            msg = "There is no such item in your basket.";
            return false;
        }
        msg = "Removed " + items_[index].product->fullName() + " from your basket.";
        items_.erase(items_.begin() + static_cast<ptrdiff_t>(index));
        return true;
    }

    bool setQuantityAt(size_t index, int qty, string& msg) {
        if (index >= items_.size()) {
            msg = "There is no such item in your basket.";
            return false;
        }
        if (qty <= 0) return removeAt(index, msg);
        BasketItem& it = items_[index];
        if (qty > it.product->stock()) {
            msg = "Not enough stock: only " + to_string(it.product->stock()) + " available.";
            return false;
        }
        it.quantity = qty;
        msg = "Quantity of " + it.product->fullName() + " is now " + to_string(qty) + ".";
        return true;
    }

    void clear() { items_.clear(); }

private:
    vector<BasketItem> items_;
};

// ============================================================ CompatibilityChecker

class CompatibilityChecker {
public:
    // Returns lines such as "[OK] ..." or "[!] ...". Empty if there is nothing to compare yet.
    static vector<string> check(const Basket& basket) {
        vector<string> out;
        int nCpu = 0, nBoard = 0, nRam = 0, nCase = 0, nGpu = 0, nPsu = 0;
        const Cpu* cpu = findPart<Cpu>(basket, nCpu);
        const Motherboard* board = findPart<Motherboard>(basket, nBoard);
        const Memory* ram = findPart<Memory>(basket, nRam);
        const PcCase* pcCase = findPart<PcCase>(basket, nCase);
        const Gpu* gpu = findPart<Gpu>(basket, nGpu);
        const PowerSupply* psu = findPart<PowerSupply>(basket, nPsu);

        if (nCpu > 1) out.push_back("[!] You have more than one CPU in your basket.");
        if (nBoard > 1) out.push_back("[!] You have more than one motherboard in your basket.");
        if (nCase > 1) out.push_back("[!] You have more than one case in your basket.");
        if (nPsu > 1) out.push_back("[!] You have more than one power supply in your basket.");

        if (cpu && board) {
            if (cpu->socket() == board->socket())
                out.push_back("[OK] CPU and motherboard share the " + cpu->socket() + " socket.");
            else
                out.push_back("[!] CPU socket " + cpu->socket() + " does not match the motherboard socket " +
                              board->socket() + ".");
        }
        if (ram && board) {
            if (ram->type() == board->memoryType())
                out.push_back("[OK] " + ram->type() + " memory matches the motherboard.");
            else
                out.push_back("[!] The memory is " + ram->type() + " but the motherboard needs " +
                              board->memoryType() + ".");
        }
        if (pcCase && board) {
            if (pcCase->fits(board->formFactor()))
                out.push_back(string("[OK] The ") + formFactorName(board->formFactor()) +
                              " motherboard fits in the case.");
            else
                out.push_back(string("[!] The ") + formFactorName(board->formFactor()) +
                              " motherboard will not fit in this case, which only takes up to " +
                              formFactorName(pcCase->maxBoard()) + ".");
        }
        if (psu && (cpu || gpu)) {
            int need = 150 + (cpu ? cpu->tdpW() : 0) + (gpu ? gpu->tdpW() : 0);  // 150 W for the rest of the PC
            if (psu->watts() >= need)
                out.push_back("[OK] The " + to_string(psu->watts()) + " W power supply covers the estimated " +
                              to_string(need) + " W need.");
            else
                out.push_back("[!] The " + to_string(psu->watts()) + " W power supply is too small: about " +
                              to_string(need) + " W is recommended.");
        }
        return out;
    }

private:
    // First part of type T in the basket; `count` receives how many units of that type there are.
    template <typename T>
    static const T* findPart(const Basket& basket, int& count) {
        const T* found = nullptr;
        count = 0;
        for (const auto& it : basket.items())
            if (const T* p = dynamic_cast<const T*>(it.product)) {
                if (!found) found = p;
                count += it.quantity;
            }
        return found;
    }
};

// ============================================================ Console (input helpers)

struct InputClosed {};  // thrown when the keyboard input ends (Ctrl+D / Ctrl+Z)

class Console {
public:
    static string readLine(const string& prompt) {
        cout << prompt << flush;
        string text;
        if (!getline(cin, text)) throw InputClosed{};
        return trim(text);
    }

    static int readInt(const string& prompt, int lo, int hi) {
        for (;;) {
            string text = readLine(prompt);
            try {
                size_t used = 0;
                int v = stoi(text, &used);
                if (used == text.size() && v >= lo && v <= hi) return v;
            } catch (const exception&) {
                // fall through to the message below
            }
            cout << "  Please enter a number from " << lo << " to " << hi << ".\n";
        }
    }
};

// ============================================================ Store (menus and flow)

class Store {
public:
    void run() {
        cout << "\n" << line('=', 64) << "\n"
                  << "                     PC PARTS STORE\n"
                  << "     Build your own computer - parts, peripherals, monitors\n"
                  << line('=', 64) << "\n";
        for (;;) {
            cout << "\n--- MAIN MENU ---   Basket: " << basket_.unitCount() << " item(s), "
                      << formatMoney(basket_.totalCents()) << "\n"
                      << "  1. Browse by category\n"
                      << "  2. Search products\n"
                      << "  3. Show every product\n"
                      << "  4. View basket (remove items / change quantity)\n"
                      << "  5. Checkout\n"
                      << "  0. Exit\n";
            switch (Console::readInt("Choose: ", 0, 5)) {
                case 1: browseCategories(); break;
                case 2: searchProducts(); break;
                case 3: showProductList(allProducts(), "ALL PRODUCTS"); break;
                case 4: viewBasket(); break;
                case 5: checkout(); break;
                case 0:
                    cout << "\nThanks for visiting. Goodbye!\n";
                    return;
            }
        }
    }

private:
    Catalog catalog_;
    Basket basket_;
    int orderNumber_ = 0;

    vector<Product*> allProducts() const {
        vector<Product*> v;
        for (const auto& p : catalog_.all()) v.push_back(p.get());
        return v;
    }

    // ---------------------------------------------------------------- browsing

    void browseCategories() {
        for (;;) {
            cout << "\n--- CATEGORIES ---\n";
            for (size_t i = 0; i < kAllCategories.size(); ++i)
                cout << "  " << (i + 1) << ". " << categoryName(kAllCategories[i]) << "\n";
            cout << "  0. Back\n";
            int c = Console::readInt("Choose: ", 0, static_cast<int>(kAllCategories.size()));
            if (c == 0) return;
            Category cat = kAllCategories[static_cast<size_t>(c - 1)];
            showProductList(catalog_.byCategory(cat), categoryName(cat));
        }
    }

    void searchProducts() {
        string q = Console::readLine("\nSearch (e.g. \"rtx 5070\", \"ddr5\", \"samsung\"): ");
        if (q.empty()) return;
        showProductList(catalog_.search(q), "SEARCH RESULTS FOR \"" + q + "\"");
    }

    void showProductList(const vector<Product*>& products, const string& title) {
        if (products.empty()) {
            cout << "\nNo products found.\n";
            return;
        }
        for (;;) {
            cout << "\n=== " << title << " ===\n"
                      << fit("ID", 6) << fit("PRODUCT", 44) << padLeft("PRICE", 11) << "  " << "STOCK\n"
                      << line('-', 72) << "\n";
            for (const Product* p : products) {
                string stock = p->stock() > 0 ? to_string(p->stock()) + " left" : "SOLD OUT";
                cout << fit(to_string(p->id()), 6) << fit(p->fullName(), 44)
                          << padLeft(formatMoney(p->priceCents()), 11) << "  " << stock << "\n";
            }
            int id = Console::readInt("\nEnter a product ID to view it / add it to the basket (0 = back): ", 0, 999999);
            if (id == 0) return;
            auto it = find_if(products.begin(), products.end(), [id](const Product* p) { return p->id() == id; });
            if (it == products.end()) {
                cout << "  That ID is not in this list.\n";
                continue;
            }
            showProduct(**it);
        }
    }

    void showProduct(Product& p) {
        cout << "\n" << line('=', 64) << "\n"
                  << p.fullName() << "\n"
                  << line('-', 64) << "\n"
                  << "  Category : " << categoryName(p.category()) << "\n"
                  << "  Price    : " << formatMoney(p.priceCents()) << "\n"
                  << "  In stock : " << p.stock() << "\n";
        for (const string& s : p.specs()) cout << "  " << s << "\n";
        cout << line('=', 64) << "\n";

        int inBasket = basket_.quantityOf(p);
        if (inBasket > 0) cout << "  (You already have " << inBasket << " of these in your basket.)\n";

        int room = p.stock() - inBasket;
        if (room <= 0) {
            cout << (p.stock() == 0 ? "  This product is sold out.\n"
                                         : "  Your basket already holds all the stock of this product.\n");
            return;
        }
        cout << "  1. Add to basket\n  0. Back\n";
        if (Console::readInt("Choose: ", 0, 1) != 1) return;
        int qty = Console::readInt("Quantity (1-" + to_string(room) + "): ", 1, room);
        string msg;
        basket_.add(p, qty, msg);
        cout << "  " << msg << "\n";
    }

    // ---------------------------------------------------------------- basket

    void printBasket() const {
        cout << "\n=== YOUR BASKET ===\n"
                  << fit("#", 4) << fit("PRODUCT", 40) << padLeft("PRICE", 11) << padLeft("QTY", 5)
                  << padLeft("TOTAL", 13) << "\n"
                  << line('-', 73) << "\n";
        int n = 1;
        for (const BasketItem& it : basket_.items()) {
            cout << fit(to_string(n++), 4) << fit(it.product->fullName(), 40)
                      << padLeft(formatMoney(it.product->priceCents()), 11) << padLeft(to_string(it.quantity), 5)
                      << padLeft(formatMoney(it.lineTotalCents()), 13) << "\n";
        }
        cout << line('-', 73) << "\n"
                  << fit("", 4) << fit("TOTAL (" + to_string(basket_.unitCount()) + " items)", 56)
                  << padLeft(formatMoney(basket_.totalCents()), 13) << "\n";

        auto notes = CompatibilityChecker::check(basket_);
        if (!notes.empty()) {
            cout << "\nCompatibility check:\n";
            for (const string& s : notes) cout << "  " << s << "\n";
        }
    }

    void viewBasket() {
        for (;;) {
            if (basket_.empty()) {
                cout << "\nYour basket is empty.\n";
                return;
            }
            printBasket();
            cout << "\n  1. Remove an item\n"
                      << "  2. Change an item's quantity\n"
                      << "  3. Empty the basket\n"
                      << "  4. Checkout\n"
                      << "  0. Back\n";
            string msg;
            int count = static_cast<int>(basket_.items().size());
            switch (Console::readInt("Choose: ", 0, 4)) {
                case 1: {
                    int n = Console::readInt("Item number to remove (0 = cancel): ", 0, count);
                    if (n > 0) {
                        basket_.removeAt(static_cast<size_t>(n - 1), msg);
                        cout << "  " << msg << "\n";
                    }
                    break;
                }
                case 2: {
                    int n = Console::readInt("Item number to change (0 = cancel): ", 0, count);
                    if (n > 0) {
                        int q = Console::readInt("New quantity (0 = remove): ", 0, 999);
                        basket_.setQuantityAt(static_cast<size_t>(n - 1), q, msg);
                        cout << "  " << msg << "\n";
                    }
                    break;
                }
                case 3:
                    if (Console::readInt("Really empty the basket? 1 = yes, 0 = no: ", 0, 1) == 1) {
                        basket_.clear();
                        cout << "  Basket emptied.\n";
                    }
                    break;
                case 4: checkout(); return;
                case 0: return;
            }
        }
    }

    // ---------------------------------------------------------------- checkout

    void checkout() {
        if (basket_.empty()) {
            cout << "\nYour basket is empty - add something first.\n";
            return;
        }
        printBasket();
        cout << "\n";
        if (Console::readInt("Place this order? 1 = yes, 0 = no: ", 0, 1) != 1) return;

        string customer = Console::readLine("Your name (for the receipt): ");
        if (customer.empty()) customer = "Customer";

        // Take the stock first; if anything fails nothing is sold.
        for (const BasketItem& it : basket_.items()) {
            if (it.quantity > it.product->stock()) {
                cout << "  Sorry, " << it.product->fullName() << " is no longer available in that quantity.\n";
                return;
            }
        }
        for (const BasketItem& it : basket_.items()) it.product->takeStock(it.quantity);

        ++orderNumber_;
        string receipt = buildReceipt(customer);
        cout << "\n" << receipt;

        string file = "receipt_" + timestamp("%Y%m%d_%H%M%S") + "_" + to_string(orderNumber_) + ".txt";
        ofstream out(file);
        if (out) {
            out << receipt;
            cout << "Receipt saved to " << file << "\n";
        } else {
            cout << "(Could not save the receipt file.)\n";
        }
        basket_.clear();
    }

    string buildReceipt(const string& customer) const {
        ostringstream r;
        r << line('=', 64) << "\n"
          << "                     PC PARTS STORE - RECEIPT\n"
          << line('=', 64) << "\n"
          << "Order #  : " << orderNumber_ << "\n"
          << "Date     : " << timestamp("%Y-%m-%d %H:%M:%S") << "\n"
          << "Customer : " << customer << "\n"
          << line('-', 64) << "\n";
        for (const BasketItem& it : basket_.items())
            r << fit(to_string(it.quantity) + " x " + it.product->fullName(), 49)
              << padLeft(formatMoney(it.lineTotalCents()), 15) << "\n";
        r << line('-', 64) << "\n"
          << fit("TOTAL", 49) << padLeft(formatMoney(basket_.totalCents()), 15) << "\n"
          << line('=', 64) << "\n"
          << "Thank you for your order!\n";
        return r.str();
    }
};

// ============================================================ main

int main() {
    try {
        Store store;
        store.run();
    } catch (const InputClosed&) {
        cout << "\nInput closed. Goodbye!\n";
    }
    return 0;
}
