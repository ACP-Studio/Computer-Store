// ============================================================ Catalog

class Catalog {
public:
    Catalog() { populate(); }

    const vector<unique_ptr<Product>>& all() const { return products_; }

    Product* find(int id) const {
        for (const auto& p : products_)
            if (p->id() == id) return p.get();
        return nullptr;
    }

    vector<Product*> byCategory(Category c) const {
        vector<Product*> out;
        for (const auto& p : products_)
            if (p->category() == c) out.push_back(p.get());
        return out;
    }

    // Every word you type must appear in the brand, name, category or specs (case-insensitive).
    vector<Product*> search(const string& query) const {
        vector<string> words;
        istringstream in(toLower(query));
        for (string w; in >> w;) words.push_back(w);
        vector<Product*> out;
        if (words.empty()) return out;
        for (const auto& p : products_) {
            string hay = p->fullName() + " " + categoryName(p->category());
            for (const string& spec : p->specs()) hay += " " + spec;  // so "ddr4", "am5", "oled" work too
            hay = toLower(hay);
            bool matches = all_of(words.begin(), words.end(),
                                   [&](const string& w) { return hay.find(w) != string::npos; });
            if (matches) out.push_back(p.get());
        }
        return out;
    }

private:
    vector<unique_ptr<Product>> products_;
    int nextId_ = 1001;

    // Adds a product of type T; the id is handed out automatically.
